{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "germomics",
	"main": "./workers/app.ts",
	// No newer than the workerd that @cloudflare/vite-plugin bundles supports, or `npm run dev` refuses to start.
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat"],
	// Keep dashboard-set vars/secrets (ADMIN_EMAIL, ACCESS_TEAM_DOMAIN, ACCESS_AUD,
	// BETTER_AUTH_SECRET for preview tokens) from being wiped on deploy.
	"keep_vars": true,
	"observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.1 } },
	// THE MAPS KEY IS A BUILD-TIME VALUE AND IS DELIBERATELY NOT A `vars` ENTRY HERE.
	//
	//   VITE_GOOGLE_MAPS_KEY      the Maps JavaScript API browser key
	//   VITE_GOOGLE_MAPS_MAP_ID   the Map ID Advanced Markers require
	//
	// Vite inlines every VITE_* value into the CLIENT bundle when `react-router build` runs, so
	// both have to exist as BUILD environment variables (Workers Builds settings, or .env
	// locally). A Worker runtime var is invisible to a browser bundle and would not feed them.
	//
	// Writing them into `vars` would also be actively harmful: `keep_vars` protects only vars
	// that are ABSENT from this file, so listing them with placeholder values would overwrite
	// the dashboard values on every deploy. Declared here as documentation instead. Shape and
	// the referrer-restriction requirement: .env.example.

	"upload_source_maps": true,
	// Native bindings, reached only via context.cloudflare.env in loaders/actions.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "germomics",
			"database_id": "fbdeae30-5986-4816-9b7c-21136d8e372c",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{ "binding": "MEDIA", "bucket_name": "germomics-audio" },
		{ "binding": "BLOG_IMAGES", "bucket_name": "germomics-blog-images" },
		{ "binding": "GAME_ASSETS", "bucket_name": "germomics-game-assets" },
		// Nightly D1 dumps (d1-dump). The bucket must exist before this deploys; see CLAUDE.md "Backup".
		{ "binding": "BACKUPS", "bucket_name": "germomics-backups" }
	],
	// Rate limit for Carrel's site API (app/lib/carrel). namespace_id must be unique to this site:
	// sites in one account that share one share counters.
	"ratelimits": [
		{ "name": "CARREL_RATE_LIMIT", "namespace_id": "7301", "simple": { "limit": 120, "period": 60 } },
		// CSP violation reports (/csp-report), per address. Loose, because a page tripping ten rules sends ten.
		{ "name": "CSP_REPORT_RATE_LIMIT", "namespace_id": "7302", "simple": { "limit": 60, "period": 60 } }
	],
	// 03:17 UTC nightly: runBackup() in app/lib/backup.server.ts.
	"triggers": { "crons": ["17 3 * * *"] },
	"kv_namespaces": [
		{ "binding": "APP_KV", "id": "da89f831723f4ce5802f0c877f4c2209" }
	]
}
