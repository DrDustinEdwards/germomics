{
  // Germomics Admin, its own Worker. CI deploys it on a merge to main (.github/workflows/ci.yml, the `mcp-deploy` job):
  // it copies this file to wrangler.jsonc (gitignored) and fills the OAUTH_KV id by the namespace's
  // title, germomics-admin-mcp-oauth. Locally: copy it and fill the id by hand.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "germomics-admin-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // global_fetch_strictly_public: the OAuth provider fetches a Client ID
  // Metadata Document (CIMD) from the client's URL. At this compatibility date
  // nodejs_compat is on by default, which the MCP SDK needs.
  "compatibility_flags": ["global_fetch_strictly_public"],

  // Logs: every invocation (head_sampling_rate 1), stated so a change to it is a reviewed one; an admin
  // server's traffic is one person's.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "minify": true,
  "upload_source_maps": true,

  // ADDRESS: admin-mcp.germomics.com, a Custom Domain. The deploy attaches it,
  // which needs the germomics.com zone to hold no other record for that name.
  "workers_dev": false,
  "routes": [{ "pattern": "admin-mcp.germomics.com", "custom_domain": true }],

  // Non-secret. (ADMIN_EMAIL is a Worker secret, below, so this public file names nobody.)
  // PUBLIC_ORIGIN: this server's own origin; every access token is bound to
  //   PUBLIC_ORIGIN + /mcp (RFC 8707). Unset serves nothing.
  // SITE_ORIGIN: the URL the germomics Worker sees over the SITE binding.
  // ACCESS_TEAM_DOMAIN: the Cloudflare Access team, https://<team>.cloudflareaccess.com,
  //   the same team Capsid and Carrel sign in through.
  // DCR_REDIRECT_URIS: the exact allowlist for dynamically registered clients
  //   (rule 13), comma separated. Empty refuses every registration.
  "vars": {
    "PUBLIC_ORIGIN": "https://admin-mcp.germomics.com",
    "SITE_ORIGIN": "https://germomics.com",
    "ACCESS_TEAM_DOMAIN": "https://dustinedwards.cloudflareaccess.com",
    "DCR_REDIRECT_URIS": "https://vertexaisearch.cloud.google.com/oauth-redirect"
  },

  // THE ONLY ROUTE TO GERMOMICS: a service binding to the germomics Worker. Still HTTP,
  // still the operator bearer, still the operator API's checks and rate limit.
  "services": [{ "binding": "SITE", "service": "germomics" }],

  // BINDINGS ARE AN ALLOWLIST (test/wrapper.test.ts derives it from this block).
  // No D1, no site bucket, no binding of any kind that reaches Germomics' data: the
  // only path is HTTP to /api/operator over SITE. The one R2 bucket holds only
  // this server's own tool-call log copies.
  // The tool-call log's copies (checklist L6-L7): the daily cron copies new rows here as
  // tool-calls/<first>-<last>.json, then the log drops copied rows older than 90 days.
  // The bucket has a lock rule on tool-calls/ so a copy cannot be changed or removed.
  "r2_buckets": [{ "binding": "AUDIT_BUCKET", "bucket_name": "germomics-admin-mcp-tool-calls" }],
  "triggers": { "crons": ["29 4 * * *"] },

  "kv_namespaces": [
    {
      // Token and grant storage for the OAuth provider. Its own namespace.
      "binding": "OAUTH_KV",
      "id": "YOUR_OAUTH_KV_ID"
    }
  ],

  "durable_objects": {
    "bindings": [
      // The rate limiter: site-runtime's RateLimiter, src/index.ts.
      { "name": "MCP_RATE_LIMIT", "class_name": "McpRateLimit" },
      // The append-only tool-call log, rule 12.4, @dustinedwards/site-runtime/audit-log.
      { "name": "TOOL_CALL_LOG", "class_name": "ToolCallLog" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["McpRateLimit", "ToolCallLog"] }]

  // Secrets, set with `npx wrangler secret put <NAME> --name germomics-admin-mcp`, never committed;
  // a deploy keeps them:
  //   ADMIN_EMAIL           the one email let in, as Access verifies it at sign-in.
  //   OPERATOR_TOKEN        the API leg. Same value as the germomics Worker's OPERATOR_TOKEN
  //                         secret. At least 32 characters.
  //   AUDIT_SIGNING_KEY     the seed of the tool-call log's Ed25519 signing key (site-runtime audit-log 0.85); minted by the deploy.
  //   ACCESS_SAAS_CLIENT_ID      the Access for SaaS (OIDC) app used for sign-in,
  //                              with redirect URL PUBLIC_ORIGIN + /callback.
  //   ACCESS_SAAS_CLIENT_SECRET  ditto.
  //   MCP_PROBE_KEY         optional: the list-only test key for the daily live check. It can list
  //                         tools and runs none (site-runtime probeDoor). At least 32 characters.
}
