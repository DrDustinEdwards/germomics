{
  "name": "germomics-admin-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Germomics Admin: the admin MCP server for germomics.com, a wrapper over its operator API. Contains no policy.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "wrangler types && tsc -b",
    "test": "node --import ./test/resolve-ts.mjs --test \"test/**/*.test.ts\"",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "check:conformance": "devkit-conformance"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.80.0",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.32.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.21.5",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "typescript": "5.9.3",
    "wrangler": "4.151.3"
  },
  "allowScripts": {
    "core-js-pure": false,
    "esbuild": false,
    "workerd": false
  }
}
