{
  "name": "germomics",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "test": "vitest run",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy -c build/server/wrangler.json",
    "preview": "npm run build && vite preview",
    "typegen": "wrangler types",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply germomics --local",
    "db:migrate:prod": "wrangler d1 migrations apply germomics --remote",
    "postinstall": "node scripts/run-wrangler-types.mjs",
    "check:postinstall": "node scripts/check-postinstall.mjs",
    "nobloat:knip": "react-router typegen && mkdir -p .nobloat && knip --no-exit-code --no-progress --reporter json > .nobloat/knip.json && node scripts/nobloat.mjs knip",
    "nobloat:jscpd": "jscpd && node scripts/nobloat.mjs jscpd",
    "nobloat:weight": "node scripts/nobloat.mjs weight",
    "nobloat:baseline": "npm run nobloat:knip && npm run nobloat:jscpd && npm run build && node scripts/nobloat.mjs baseline"
  },
  "dependencies": {
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.4.1",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.2.0",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.5.0",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.36",
    "jose": "^6.2.12",
    "lucide-react": "^1.21.0",
    "phaser": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.3.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "audio-decode": "^3.11.0",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.103.0"
  }
}
