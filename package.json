{
  "name": "germomics",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "node scripts/gen-headers.mjs && react-router build",
    "dev": "react-router dev",
    "test": "vitest run",
    "typecheck": "devkit-bootstrap --types-only && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy -c build/server/wrangler.json",
    "preview": "npm run build && vite preview",
    "typegen": "devkit-bootstrap --types-only",
    "cf-typegen": "devkit-bootstrap --types-only",
    "db:migrate": "wrangler d1 migrations apply germomics --local",
    "db:migrate:prod": "wrangler d1 migrations apply germomics --remote",
    "postinstall": "devkit-bootstrap",
    "check:postinstall": "devkit-bootstrap --check",
    "nobloat": "react-router typegen && devkit-no-bloat --warn-only",
    "nobloat:weight": "devkit-route-weight",
    "report:mutation": "devkit-mutation-report --protected \"auth|access|security|sanitiz|xss|csp|session|admin|login|jwt|backup|restore|token|secret|permission|regression|fix|bug\" --json docs/research/kill-matrix.json",
    "nobloat:baseline": "react-router typegen && devkit-no-bloat --write-baseline && npm run build && devkit-route-weight --write-baseline"
  },
  "dependencies": {
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.22.1",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.7.0",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.14.0",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.48.0",
    "@googlemaps/js-api-loader": "2.1.3",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.54.0",
    "drizzle-orm": "0.45.4",
    "hast-util-to-string": "3.0.1",
    "isbot": "5.2.2",
    "lucide-react": "1.61.0",
    "parse5": "8.0.1",
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-smartypants": "3.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/vitest-plugin": "1.4.6",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.20.7",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/google.maps": "3.66.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "audio-decode": "3.12.0",
    "knip": "6.43.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.130.0"
  }
}
