{
  "name": "germomics",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "test": "vitest run",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy -c build/server/wrangler.json",
    "preview": "npm run build && vite preview",
    "typegen": "wrangler types",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply germomics --local",
    "db:migrate:prod": "wrangler d1 migrations apply germomics --remote",
    "postinstall": "node scripts/run-wrangler-types.mjs",
    "check:postinstall": "node scripts/check-postinstall.mjs",
    "nobloat:knip": "react-router typegen && mkdir -p .nobloat && knip --no-exit-code --no-progress --reporter json > .nobloat/knip.json && node scripts/nobloat.mjs knip",
    "nobloat:jscpd": "jscpd && node scripts/nobloat.mjs jscpd",
    "nobloat:weight": "devkit-route-weight",
    "nobloat:baseline": "npm run nobloat:knip && npm run nobloat:jscpd && node scripts/nobloat.mjs baseline && npm run build && devkit-route-weight --write-baseline"
  },
  "dependencies": {
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.5.0",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.5.1",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.7.2",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.9.0",
    "@googlemaps/js-api-loader": "2.1.1",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.11.2",
    "drizzle-orm": "0.45.2",
    "isbot": "5.1.43",
    "lucide-react": "1.21.0",
    "phaser": "4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.1",
    "recharts": "3.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.9.0",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "4.3.1",
    "@types/google.maps": "3.66.2",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "audio-decode": "3.11.0",
    "jose": "6.2.12",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.11",
    "wrangler": "4.130.0"
  }
}
