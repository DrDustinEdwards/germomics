{
  "name": "germomics",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy -c build/server/wrangler.json",
    "preview": "npm run build && vite preview",
    "typegen": "wrangler types",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply germomics --local",
    "db:migrate:prod": "wrangler d1 migrations apply germomics --remote",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "better-auth": "^1.6.20",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.36",
    "lucide-react": "^1.21.0",
    "phaser": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.0.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.1",
    "@react-router/dev": "8.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "audio-decode": "^3.11.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.103.0"
  }
}
