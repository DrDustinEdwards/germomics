{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(npm:*)",
      "Bash(npx tsc:*)",
      "Bash(npx wrangler:*)",
      "Bash(wrangler:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && npx tsc --noEmit 2>&1 | tail -20; exit ${PIPESTATUS[0]}"
          }
        ]
      }
    ]
  }
}
